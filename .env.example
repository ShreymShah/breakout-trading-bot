TT_USERNAME=your_tastytrade_username
TT_PASSWORD=your_tastytrade_password
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
SYMBOL_BASE=/MES

# Optional: override the default single session with one or more sessions.
# Each key is a session id; each value needs name, ref_hour, start_hour,
# end_hour, target_points, stop_points. Omit to use the built-in default.
# SESSIONS_JSON={"22":{"name":"London","ref_hour":22,"start_hour":23,"end_hour":23,"target_points":0.2,"stop_points":0.5},"4":{"name":"Late NY","ref_hour":4,"start_hour":5,"end_hour":13,"target_points":1,"stop_points":2}}
